
FABRIC_SERVER=
FABRIC_DATABASE=
GEMINI_API_KEY=
GEMINI_MODEL=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=

# App metadata DB (users, connectors, S2D mappings/results, schedules, etc).
# Unset (or omitted entirely) -> local SQLite file (catalog.db), the default
# for local dev/testing - no server, no setup needed.
# Set to a real Postgres URL for production, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
# No other change needed - every table is created via CREATE TABLE IF NOT
# EXISTS, so pointing this at a fresh empty Postgres database is enough.
DATABASE_URL=