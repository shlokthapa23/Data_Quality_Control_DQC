  <!-- Outer Dashed Concept Circle -->
  <circle cx=3D"250" cy=3D"200" r=3D"160" fill=3D"none" stroke=3D"url(#prim=
aryGradient)" stroke-width=3D"3.5" stroke-linecap=3D"round" stroke-dasharra=
y=3D"16 14"></circle>

  <!-- Main Illustration Group -->
  <g fill=3D"none" stroke=3D"url(#primaryGradient)" stroke-width=3D"4" stro=
ke-linecap=3D"round" stroke-linejoin=3D"round">

    <!-- TOP-RIGHT: Charts Area -->
    <!-- Base shelf/axis -->
    <line x1=3D"230" y1=3D"185" x2=3D"365" y2=3D"185"></line>
   =20
    <!-- Vertical Bar 1 -->
    <rect x=3D"240" y=3D"65" width=3D"28" height=3D"120" rx=3D"3"></rect>
   =20
    <!-- Vertical Bar 2 -->
    <rect x=3D"285" y=3D"140" width=3D"28" height=3D"45" rx=3D"3"></rect>
   =20
    <!-- Vertical Bar 3 (Right) -->
    <rect x=3D"325" y=3D"140" width=3D"32" height=3D"45" rx=3D"3"></rect>
   =20
    <!-- Pie Chart -->
    <g transform=3D"translate(325, 100)">
      <circle cx=3D"0" cy=3D"0" r=3D"38"></circle>
      <path d=3D"M 0,-38 L 0,0 L 27,27"></path>
      <path d=3D"M 0,0 L 38,-3"></path>
    </g>


    <!-- TOP-LEFT: Quality Rosette / Badge -->
    <!-- Ribbon tails -->
    <path d=3D"M 115 190 L 100 245 L 140 230 L 160 255 L 175 210"></path>
    <path d=3D"M 185 210 L 200 255 L 220 230 L 260 245 L 245 190"></path>
   =20
    <!-- Rosette Scalloped Outer Border -->
    <path d=3D"
      M 160 70
      C 166 60, 179 60, 185 70
      C 194 65, 206 70, 210 80
      C 221 80, 229 90, 228 100
      C 238 105, 241 118, 236 128
      C 243 136, 240 149, 232 156
      C 234 167, 226 177, 216 180
      C 213 190, 201 196, 192 192
      C 184 200, 171 200, 165 192
      C 156 196, 144 190, 141 180
      C 131 177, 123 167, 125 156
      C 117 149, 114 136, 121 128
      C 116 118, 119 105, 129 100
      C 128 90, 136 80, 147 80
      C 151 70, 163 65, 172 70 Z
    "></path>
   =20
    <!-- Badge Inner Ring -->
    <circle cx=3D"178" cy=3D"132" r=3D"36"></circle>
   =20
    <!-- Checkmark Inside Badge -->
    <path d=3D"M 160 133 L 173 147 L 202 117" stroke-width=3D"5"></path>


    <!-- BOTTOM-RIGHT: Dashboard / Application Window -->
    <!-- Window Outline -->
    <rect x=3D"230" y=3D"208" width=3D"135" height=3D"112" rx=3D"7"></rect>
   =20
    <!-- Header Divider -->
    <line x1=3D"230" y1=3D"238" x2=3D"365" y2=3D"238"></line>
   =20
    <!-- Window Control Dots -->
    <circle cx=3D"248" cy=3D"223" r=3D"3.5"></circle>
    <circle cx=3D"263" cy=3D"223" r=3D"3.5"></circle>
    <circle cx=3D"278" cy=3D"223" r=3D"3.5"></circle>
   =20
    <!-- Mini Line Chart inside Window -->
    <path d=3D"M 305 264 L 322 254 L 338 268 L 354 246"></path>
   =20
    <!-- Mini Bar Chart inside Window -->
    <rect x=3D"306" y=3D"278" width=3D"14" height=3D"28" rx=3D"1.5"></rect>
    <rect x=3D"326" y=3D"290" width=3D"14" height=3D"16" rx=3D"1.5"></rect>
    <rect x=3D"344" y=3D"270" width=3D"14" height=3D"36" rx=3D"1.5"></rect>


    <!-- CENTER-BOTTOM: Magnifying Glass with Eye -->
    <!-- Lens Outer Circle (covers behind handle) -->
    <circle cx=3D"260" cy=3D"292" r=3D"35" fill=3D"#ffffff"></circle>
   =20
    <!-- Eye Shape inside Lens -->
    <path d=3D"M 238 292 Q 260 274 282 292 Q 260 310 238 292 Z"></path>
    <circle cx=3D"260" cy=3D"292" r=3D"6" fill=3D"url(#primaryGradient)"></=
circle>
   =20
    <!-- Magnifier Handle -->
    <g transform=3D"rotate(-40 228 322)">
      <path d=3D"M 223 318 L 223 344 C 223 350 233 350 233 344 L 233 318" f=
ill=3D"#ffffff"></path>
    </g>

  </g>

  <!-- Typography -->
  <g font-family=3D"system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica=
, Arial, sans-serif" font-weight=3D"700" font-size=3D"21" fill=3D"url(#text=
Gradient)" text-anchor=3D"middle" letter-spacing=3D"1.5">
    <text x=3D"250" y=3D"415">DATA QUALITY</text>
    <text x=3D"250" y=3D"445">CONTROL</text>
  </g>
</svg>

</body></html>
