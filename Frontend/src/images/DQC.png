adow: 0 24px 38px 3px rgba(var(--gm3-sys-color-shadow-rgb,0,0,0),.14),0 9px=
 46px 8px rgba(var(--gm3-sys-color-shadow-rgb,0,0,0),.12),0 11px 15px -7px =
rgba(var(--gm3-sys-color-shadow-rgb,0,0,0),.2); padding: 0px; }

.full-screen-share-client-dialog { height: 100vh; overflow: hidden; backgro=
und-color: transparent !important; border-width: medium !important; border-=
style: none !important; border-color: currentcolor !important; border-image=
: none !important; padding: 0px !important; width: 100vw !important; }

.full-screen-share-client-dialog .modal-dialog-content { background: transp=
arent; height: 100%; width: 100%; }

.modal-dialog.share-client-dialog.team-drive-share-client-dialog { padding:=
 0px; }

.full-screen-share-client-dialog .modal-dialog-title, .team-drive-share-cli=
ent-dialog .modal-dialog-title { display: none; }

.modal-dialog-bg { z-index: 1000; }

.modal-dialog { z-index: 1001; }

.share-client-content-iframe { color-scheme: auto; }

