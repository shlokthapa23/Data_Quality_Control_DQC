html { height: 100%; width: 100%; overflow: hidden; }

body { color: var(--gem-sys-color--on-surface); background-color: var(--bar=
d-color-synthetic--chat-window-surface); margin: 0px; height: 100%; width: =
100%; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: n=
ormal; flex-direction: column; -webkit-font-smoothing: antialiased; word-br=
eak: auto-phrase; }

body.lm-component-theme { background-color: var(--lumi-sys-color--surface);=
 }

.xap-inline-dialog-container:has(.info-tooltip-body) { box-shadow: none; ba=
ckground: transparent; border-radius: 0px; overflow: visible; }

body.fre-autosize-enabled { position: relative; }

html.fre-autosize-enabled { height: fit-content; }

@media print {
  body:has(chat-app.enable-print-overrides), html:has(chat-app.enable-print=
-overrides) { height: auto; overflow: visible; }
  chat-app.enable-print-overrides .hide-on-print { display: none !important=
; }
}

.sfc-layout-container { display: flex; -webkit-box-orient: horizontal; -web=
kit-box-direction: normal; flex-direction: row; height: 100%; width: 100%; =
}

.sfc-sidebar { width: 288px; flex-shrink: 0; height: 100%; display: flex; -=
webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction:=
 column; }

.sfc-main-content { -webkit-box-flex: 1; flex: 1 1 0%; height: 100%; positi=
on: relative; display: flex; -webkit-box-orient: vertical; -webkit-box-dire=
ction: normal; flex-direction: column; }

nav.chat-app-skip-link-nav > xap-skip-link { z-index: 1001; }

nav.chat-app-skip-link-nav > xap-skip-link:focus-within { top: 0px; left: 0=
px; }

sentinel { }
